section.section.article
	.section_in.section_in--border_mod
		+breadcrumbs({
			list: [
				{text: 'Спецпроєкти', url: '#'},
				{text: 'Мапа укриттів Київа' }
			]
		})
		h1.article__title!= "404: укриття не знайдено \nЧому безпека киян — це «службова інформація»"
		.article__team
			each item in articleTeam
				.article__team_item
					.article__team_title= item.title + ':'
					.article__team_list
						each name, index in item.list
							if index !== 0
								| ,&nbsp;
							a.article__item_name(href="#")= name

	.section_in.section_in--border_mod
		.article__content
			h2 Про спецпроєкт
			p З понад 3000 укриттів, зазначених КМДА, лише близько 300 є реальними та доступними укриттями. Короткий експлейнер (3 абзаци по 3 речення) із поясненням методології підрахунку. Короткий експлейнер (3 абзаци по 3 речення) із поясненням методології підрахунку.
