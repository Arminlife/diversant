		{
			title: 'Авторка',
			list: ['Вікторія Коломієць']
		},
		{
			title: 'Редакторки',
			list: ['Наталя Кулакевич', 'Настя Станко']
		},
		{
			title: 'Журналістка',
			list: ['Ліза Бикова']
		},
		{
			title: 'Оператор',
			list: ['Денис Клименко']
