//- Диверсанти — шапка матеріалу: хлібні крихти + заголовок + кредити.
//- Кредити — WPBakery-елемент; заголовок/крихти у WP підуть із single-header.
section.section.diversanty_head
	.section_in
		+breadcrumbs({
			list: [
				{text: 'Спецпроєкти', url: '#'},
				{text: 'Диверсанти'}
			]
		})
		h1.diversanty_head__title Диверсанти
		ul.diversanty_head__credits
			li.diversanty_head__credit Авторка: #[a.diversanty_head__name(href="#") Ім'я Прізвище]
			li.diversanty_head__credit Редактори: #[a.diversanty_head__name(href="#") Ім'я Прізвище], #[a.diversanty_head__name(href="#") Ім'я Прізвище]
			li.diversanty_head__credit Журналістка: #[a.diversanty_head__name(href="#") Ім'я Прізвище]. Оператор: #[a.diversanty_head__name(href="#") Ім'я Прізвище]
			li.diversanty_head__credit Дизайн: #[a.diversanty_head__name(href="#") Данило Маліков]. Розробка: #[a.diversanty_head__name(href="#") Михайло Каліченко]
