include ../templates/mixins/m-button

-
	newsData = [
		{
			img: 'project1.jpg',
			title: 'Коронавірус: карта закупівель медичних виробів в Україні',
			text: '«Слідство.Інфо» зібрало дані щодо необхідних засобів у державних медзакладах для боротьби проти поширення коронавірусної інфекції і сформувало на цій базі карту'
		},
		{
			img: 'project2.jpg',
			title: '«Суддівська кров» — база даних суддівських родичів',
			text: '«Суддівська кров» стане в нагоді громадським активістам, журналістам, держслужбовцям, правоохоронцям та всім, хто хоче викривати корупційні зв’язки в судовій системі'
		},
	]

section.section.projects.section--border_mod
	.section_in.section_in--border_mod
		.projects__head
			.projects__title інші спецпроєкти
			.projects__button
				+button({
					mod: 'button--v2_mod',
					href: '#',
					text: 'Усі спецпроєкти'
				})
		ul.news__list.news__list--v2_mod
			each item in newsData
				li.news__item
					a.news__link(href="#")
						+picture({
							img: item.img,
							class: 'news__image',
							img_class: 'news__image_el',
							alt: item.title
						})
						.news__title= item.title
						.news__text= item.text