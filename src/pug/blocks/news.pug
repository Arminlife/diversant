-
	newsData = [
		{
			img: 'news1.jpg',
			title: 'Найдорожчі укриття, тенедери',
			text: 'Блок з описом найдорожчих укриттів (фото, відео) - вартість, адреси. Тут буде деталізація про тендери, фірми-переможиці, власники, зв’язки з владою  ( Кличком, КМДА). Історії про фірми, капітал, чим займалися, коли створилися, у яких скандалах/судових справах фігурували.'
		},
		{
			img: 'news1.jpg',
			title: 'Зруйновані будинки та історії людей',
			text: 'Перелік зруйнованих будинків, вказати кількість жертв, ушкоджень, додати кілька історій (фото, відео, аудіо). Має бути щемко. Можливо мапу, на якій будуть лише ці 10 адрес. Де загинули діти можна позначити іграшками чи шось таке. '
		},
		{
			img: 'news1.jpg',
			title: 'Хтось покараний?',
			text: 'Тут опис найгучніших справ, фото, відео, судові засідання, коментарі тощо. І висн овок - нікого не покарали.'
		}
	]

section.section.news.section--border_mod
	.section_in.section_in--border_mod
		ul.news__list
			each item in newsData
				li.news__item
					a.news__link(href="#")
						.news__poster
							.news__details Детальніше
								.news__details__icon
									+icon('arrow')
							+picture({
								img: item.img,
								class: 'news__image',
								img_class: 'news__image_el',
								alt: item.title
							})
						.news__title= item.title
						.news__text= item.text