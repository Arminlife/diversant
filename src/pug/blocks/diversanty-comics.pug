//- Диверсанти — секція коміксу: swiper-слайдер (десктоп 2 слайди й гортання по 2 / мобілка по 1).
//- WPBakery-елемент. Використання:
//-   +diversanty_comics({ title: 'Назва коміксу', folder: 'diversanty-comic1', count: 11, caption: '...' })
//- Без folder/count рендерить плейсхолдери (для ще ненаповненого коміксу).
mixin diversanty_comics(data = {})
	- const title = data.title || 'Назва коміксу';
	- const ext = data.ext || 'jpeg';
	section.section.diversanty_comics(data-diversanty-comics)
		.section_in
			h2.diversanty_comics__title= title

			.diversanty_comics__slider.swiper(data-diversanty-comics-slider)
				.swiper-wrapper
					if data.folder && data.count
						- for (let i = 1; i <= data.count; i++)
							.swiper-slide.diversanty_comics__slide
								+picture({ img: `${data.folder}/${i}.${ext}`, class: 'diversanty_comics__panel', img_class: 'diversanty_comics__img', alt: `${title}, кадр ${i}` })
					else
						- for (let i = 1; i <= 4; i++)
							.swiper-slide.diversanty_comics__slide
								.diversanty_comics__panel
									span.diversanty_comics__panel_label Комікс #{i}

			.diversanty_comics__foot
				if data.caption
					p.diversanty_comics__caption= data.caption
				.diversanty_comics__nav
					button.diversanty_comics__arrow.diversanty_comics__arrow--prev_mod(type="button" aria-label="Попередній слайд" data-diversanty-comics-prev)
						+icon('chevron-right')
					button.diversanty_comics__arrow.diversanty_comics__arrow--next_mod(type="button" aria-label="Наступний слайд" data-diversanty-comics-next)
						+icon('chevron-right')
