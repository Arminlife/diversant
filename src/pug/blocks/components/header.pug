-
	headerMenu = [
		{
			title: 'Новини',
			url: '#'
		},
		{
			title: 'Статті',
			url: '#'
		},
		{
			title: 'Відео',
			url: '#'
		},
		{
			title: 'Фільми',
			url: '#'
		},
		{
			title: 'Спецпроєкти',
			url: '#'
		},
		{
			title: 'Про нас',
			url: '#'
		},
	]

-	headerSocial = ['x', 'facebook', 'youtube', 'instagram', 'viber', 'tiktok']

mixin header
	header.header.js-header
		.header__top.section_in.section_in--border_mod
			.header_social
				each icon in headerSocial
					li.header_social__item
						a.header_social__link(href="#")
							+icon(icon)
			a.header__logo(href="#")
				img.header__logo_el(src="./images/logo.svg", alt="logo")
			.header_search.js-header-search
				//- .header_search__form
				//- 	+form_input({
				//- 		placeholder: 'Search ...'
				//- 	})
				//- 	button.header_search__submit(type='button')
				//- 		+icon('search') 
				a.header_search__trigger(href='#').js-header-search-trigger
					+icon('search') 
			button.header__menu_trigger(type='button').js-header-menu-trigger
				span.header__menu_trigger_el
					
		.header__bottom.section_in
			nav.header_menu
				ul.header_menu__list
					each item in headerMenu
						li.header_menu__item
							a.header_menu__link(href=item.url)= item.title
			.header_buttons
				.header_buttons__item
					+btn_v2({
						text: 'Повідомити',
						mod: 'btn_v2--v2_mod'
					})
				.header_buttons__item
					+btn_v2({
						text: 'Підтримати',
					})
			.header_social.header_social--mobile_mod
				each icon in headerSocial
					li.header_social__item
						a.header_social__link(href="#")
							+icon(icon)
				