include ../../templates/mixins/m-button

mixin footer
	footer.footer
		.section_in.section_in--border_mod
			.footer__cols
				.footer__col
					.footer__text Передрук та використання матеріалів, опублікованих на Slidstvo.Info, можливий тільки за умови прямого гіперпосилання у першому чи другому абзаці. Майте на увазі, що контент, який публікує «Слідство.Інфо», переважно не призначений для дітей.
					.footer__info
						.footer__copyright © 2025 Slidstvo.Info
						a.footer__link(href="#") Політика конфіденційності
				.footer__col
					+footer_data({title: 'Електронна пошта', href:'mailto:slidstvo.info@gmail.com', content: 'slidstvo.info@gmail.com', copy: true})
					+footer_data({title: 'Номер телефону', href: 'tel:+380509755621', content: '+ 38 (050) 975-56-21'})
				.footer__col
					+footer_data({title: 'Поштова адреса', content: 'Україна, 04071, місто Київ, вул. Щекавицька, будинок 30/39, квартира 248 '})
					+footer_data({title: 'Ідентифікатор онлайн-медіа в Реєстрі', content: '№ R-40-03691'})
				.footer__col
					.footer__btn
						+btn_v2({
							mod: 'js-footer-scrollup',
							icon: 'up',
							text: 'Угору',
						})
					.footer__created
						.footer__created_title Сайт створили
						.footer__created_logo
							img.footer__created_logo_el(src="./images/demch.svg", alt="demch")

mixin footer_data(data)
	.footer_data
		.footer_data__title= data.title
		.footer_data__content
			if data.href
				a.footer_data__item(href=data.href)= data.content
			else
				div.footer_data__item= data.content
			if data.copy
				.footer_data__btn.js-copy-btn(data-copy=data.content)
					+icon('copy')
					+icon('chevron-right')