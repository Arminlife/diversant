extends ../layout/layout

block vars
	- array = {body_class:'diversanty_page', page_title:'Диверсанти'}

//- fullpage-інтро рендериться ПЕРЕД хедером (у WP — через wp_body_open)
block before_header
	include ../blocks/diversanty-intro

//- далі — звичайна сторінка спецпроєкту (хедер/футер з layout не чіпаємо).
//- Контент — WPBakery-блоки: шапка+кредити, лід (текст+телефон), комікс-слайдери, гра, фігурки.
block content_block
	include ../blocks/diversanty-head
	include ../blocks/diversanty-lead
	include ../blocks/diversanty-comics
	+diversanty_comics({ folder: 'diversanty-comic1', count: 11, title: 'Назва коміксу', caption: '16-річні ліцеїсти з Одеси шукали підробіток у телеграмі, щоб заробити «швидкі гроші».' })
	include ../blocks/diversanty-game
	+diversanty_comics({ folder: 'diversanty-comic2', count: 10, ext: 'jpg', title: 'Назва коміксу', caption: '16-річні ліцеїсти з Одеси шукали підробіток у телеграмі, щоб заробити «швидкі гроші».' })
	include ../blocks/diversanty-figures
	include ../blocks/diversanty-mosaic
