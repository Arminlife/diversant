mixin image_upload(data)
	.image_upload.js-image-upload
		.image_upload__field
			input.image_upload__field_input(id=data.id type="file" multiple).js-image-upload-input
			label.image_upload__field_label(for=data.id)
				.image_upload__field_label_icon
					+icon('camera')
				span Додати фото
		.image_upload__gallery.js-image-upload-gallery

